{
	"version": 3,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "color-primary",
					"color": "#1a1a1a",
					"name": "Color Primary"
				},
				{
					"slug": "color-secondary",
					"color": "#f0f0f0",
					"name": "Color Secondary"
				},
				{
					"slug": "color-accent",
					"color": "#ff6b00",
					"name": "Color Accent"
				},
				{
					"slug": "color-accent-aa",
					"color": "#bf5200",
					"name": "Color Accent Aa"
				},
				{
					"slug": "color-background",
					"color": "#ffffff",
					"name": "Color Background"
				},
				{
					"slug": "color-foreground",
					"color": "#1a1a1a",
					"name": "Color Foreground"
				},
				{
					"slug": "color-footer-bg",
					"color": "#111111",
					"name": "Color Footer Bg"
				},
				{
					"slug": "color-muted",
					"color": "#6b6b6b",
					"name": "Color Muted"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"margin": true,
			"padding": true,
			"spacingSizes": [
				{
					"slug": "space-10",
					"size": "8px",
					"name": "Space 10"
				},
				{
					"slug": "space-20",
					"size": "16px",
					"name": "Space 20"
				},
				{
					"slug": "space-30",
					"size": "24px",
					"name": "Space 30"
				},
				{
					"slug": "space-40",
					"size": "32px",
					"name": "Space 40"
				},
				{
					"slug": "space-50",
					"size": "48px",
					"name": "Space 50"
				},
				{
					"slug": "space-60",
					"size": "64px",
					"name": "Space 60"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"dropCap": false,
			"fontSizes": [
				{
					"slug": "font-size-small",
					"size": "14px",
					"name": "Font Size Small",
					"fluid": false
				},
				{
					"slug": "font-size-medium",
					"size": "16px",
					"name": "Font Size Medium",
					"fluid": false
				},
				{
					"slug": "font-size-large",
					"size": "20px",
					"name": "Font Size Large",
					"fluid": false
				},
				{
					"slug": "font-size-x-large",
					"size": "24px",
					"name": "Font Size X Large",
					"fluid": false
				},
				{
					"slug": "font-size-xx-large",
					"size": "36px",
					"name": "Font Size Xx Large",
					"fluid": false
				},
				{
					"slug": "font-size-xxx-large",
					"size": "48px",
					"name": "Font Size Xxx Large",
					"fluid": false
				}
			]
		},
		"custom": {
			"elevation": {
				"elevation-0": "none",
				"elevation-1": "0 1px 2px rgba(0,0,0,.06)",
				"elevation-2": "0 2px 6px rgba(0,0,0,.08)",
				"elevation-3": "0 6px 16px rgba(0,0,0,.12)",
				"elevation-4": "0 12px 32px rgba(0,0,0,.18)"
			}
		}
	}
}