{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#1a1a1a",
          "name": "Primary"
        },
        {
          "slug": "secondary",
          "color": "#f0f0f0",
          "name": "Secondary"
        },
        {
          "slug": "accent",
          "color": "#ff6b00",
          "name": "Accent"
        },
        {
          "slug": "accent-aa",
          "color": "#bf5200",
          "name": "Accent AA (白文字対応)"
        },
        {
          "slug": "background",
          "color": "#ffffff",
          "name": "Background"
        },
        {
          "slug": "foreground",
          "color": "#1a1a1a",
          "name": "Foreground"
        },
        {
          "slug": "footer-bg",
          "color": "#111111",
          "name": "Footer Background"
        },
        {
          "slug": "muted",
          "color": "#6b6b6b",
          "name": "Muted"
        }
      ],
      "gradients": [
        {
          "slug": "accent-to-primary",
          "gradient": "linear-gradient(135deg, var(--wp--preset--color--accent) 0%, var(--wp--preset--color--primary) 100%)",
          "name": "Accent → Primary"
        },
        {
          "slug": "primary-to-footer",
          "gradient": "linear-gradient(180deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--footer-bg) 100%)",
          "name": "Primary → Footer"
        },
        {
          "slug": "secondary-fade",
          "gradient": "linear-gradient(180deg, var(--wp--preset--color--secondary) 0%, var(--wp--preset--color--background) 100%)",
          "name": "Secondary fade"
        },
        {
          "slug": "accent-glow",
          "gradient": "radial-gradient(ellipse at 30% 20%, color-mix(in srgb, var(--wp--preset--color--accent) 35%, transparent) 0%, transparent 60%)",
          "name": "Accent glow"
        },
        {
          "slug": "overlay-dark",
          "gradient": "linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.65) 100%)",
          "name": "Overlay dark"
        }
      ],
      "custom": true,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Noto Sans JP', 'Hiragino Kaku Gothic ProN', sans-serif",
          "slug": "body",
          "name": "Body"
        },
        {
          "fontFamily": "'Noto Serif JP', 'Hiragino Mincho ProN', Georgia, serif",
          "slug": "heading",
          "name": "Heading"
        },
        {
          "fontFamily": "'Roboto Mono', 'Courier New', Courier, monospace",
          "slug": "mono",
          "name": "Monospace"
        }
      ],
      "defaultFontSizes": false,
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "1.5rem",
          "name": "X Large"
        },
        {
          "slug": "xx-large",
          "size": "2.25rem",
          "name": "XX Large"
        },
        {
          "slug": "xxx-large",
          "size": "3rem",
          "name": "XXX Large"
        }
      ],
      "customFontSize": true,
      "customFontFamily": true,
      "lineHeight": true,
      "letterSpacing": true
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "size": "0.5rem",
          "name": "XS"
        },
        {
          "slug": "20",
          "size": "1rem",
          "name": "Small"
        },
        {
          "slug": "30",
          "size": "1.5rem",
          "name": "Medium"
        },
        {
          "slug": "40",
          "size": "2rem",
          "name": "Large"
        },
        {
          "slug": "50",
          "size": "3rem",
          "name": "XL"
        },
        {
          "slug": "60",
          "size": "4rem",
          "name": "XXL"
        }
      ],
      "padding": true,
      "margin": true,
      "blockGap": true,
      "customSpacingSize": true,
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vw"
      ]
    },
    "blocks": {},
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "custom": {
      "fontWeight": {
        "regular": 400,
        "medium": 500,
        "bold": 700
      },
      "lineHeight": {
        "base": 1.6,
        "heading": 1.2
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--30)",
      "padding": {
        "left": "var(--wp--preset--spacing--40)",
        "right": "var(--wp--preset--spacing--40)"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent-aa)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary)"
          },
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent-aa)",
          "text": "var(--wp--preset--color--background)"
        },
        "border": {
          "radius": "4px"
        },
        "typography": {
          "fontWeight": "700",
          "fontSize": "var(--wp--preset--font-size--medium)"
        },
        "spacing": {
          "padding": {
            "top": "0.875rem",
            "bottom": "0.875rem",
            "left": "2rem",
            "right": "2rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xxx-large)",
          "lineHeight": "1.1"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      }
    },
    "blocks": {
      "core/template-part": {},
      "core/post-content": {
        "typography": {
          "lineHeight": "1.8",
          "fontSize": "1.0625rem"
        }
      },
      "core/site-title": {
        "typography": {
          "fontWeight": "700",
          "fontSize": "var(--wp--preset--font-size--large)"
        },
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "post-header",
      "title": "Post Header",
      "area": "uncategorized"
    },
    {
      "name": "post-footer",
      "title": "Post Footer",
      "area": "uncategorized"
    }
  ],
  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank",
      "postTypes": [
        "page",
        "post"
      ]
    },
    {
      "name": "no-header",
      "title": "No Header",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-lp-sample",
      "title": "LP サンプル（5セクション）",
      "postTypes": [
        "page"
      ]
    }
  ],
  "patterns": []
}
