{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#1a1a1a",
          "name": "Primary"
        },
        {
          "slug": "secondary",
          "color": "#f0f0f0",
          "name": "Secondary"
        },
        {
          "slug": "accent",
          "color": "#ff6b00",
          "name": "Accent"
        },
        {
          "slug": "background",
          "color": "#ffffff",
          "name": "Background"
        },
        {
          "slug": "foreground",
          "color": "#1a1a1a",
          "name": "Foreground"
        }
      ],
      "gradients": [],
      "custom": true,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Noto Sans JP', 'Hiragino Kaku Gothic ProN', sans-serif",
          "slug": "body",
          "name": "Body"
        },
        {
          "fontFamily": "'Noto Serif JP', 'Hiragino Mincho ProN', Georgia, serif",
          "slug": "heading",
          "name": "Heading"
        },
        {
          "fontFamily": "'Roboto Mono', 'Courier New', Courier, monospace",
          "slug": "mono",
          "name": "Monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "1.5rem",
          "name": "X Large"
        },
        {
          "slug": "xx-large",
          "size": "2rem",
          "name": "XX Large"
        }
      ],
      "customFontSize": true,
      "lineHeight": true,
      "letterSpacing": true
    },
    "spacing": {
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "spacingSizes": [
        {
          "slug": "10",
          "size": "0.5rem",
          "name": "XS"
        },
        {
          "slug": "20",
          "size": "1rem",
          "name": "Small"
        },
        {
          "slug": "30",
          "size": "1.5rem",
          "name": "Medium"
        },
        {
          "slug": "40",
          "size": "2rem",
          "name": "Large"
        },
        {
          "slug": "50",
          "size": "3rem",
          "name": "XL"
        }
      ],
      "padding": true,
      "margin": true,
      "blockGap": true,
      "customSpacingSize": true,
      "units": ["px", "em", "rem", "%", "vw"]
    },
    "blocks": {},
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "custom": {
      "fontWeight": {
        "regular": 400,
        "medium": 500,
        "bold": 700
      },
      "lineHeight": {
        "base": 1.6,
        "heading": 1.2
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--30)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary)"
          },
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--background)"
        },
        "border": {
          "radius": "4px"
        },
        "typography": {
          "fontWeight": "700"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank",
      "postTypes": ["page", "post"]
    },
    {
      "name": "no-header",
      "title": "No Header",
      "postTypes": ["page"]
    }
  ],
  "patterns": []
}
