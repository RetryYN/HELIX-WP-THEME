{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "業務",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#1b2a41", "name": "Primary" },
				{ "slug": "secondary", "color": "#f3f5f7", "name": "Secondary" },
				{ "slug": "accent", "color": "#0b7285", "name": "Accent" },
				{ "slug": "accent-aa", "color": "#095c6b", "name": "Accent AA (白文字対応)" },
				{ "slug": "background", "color": "#ffffff", "name": "Background" },
				{ "slug": "foreground", "color": "#1f2933", "name": "Foreground" },
				{ "slug": "footer-bg", "color": "#1b2a41", "name": "Footer Background" },
				{ "slug": "muted", "color": "#616e7c", "name": "Muted" }
			]
		},
		"typography": {
			"fontSizes": [
				{ "slug": "small", "size": "0.8125rem", "name": "Small" },
				{ "slug": "medium", "size": "0.9375rem", "name": "Medium" },
				{ "slug": "large", "size": "1.125rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.375rem", "name": "X-Large" },
				{ "slug": "xx-large", "size": "1.75rem", "name": "XX-Large" },
				{ "slug": "xxx-large", "size": "2.25rem", "name": "XXX-Large" }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "10", "size": "0.375rem", "name": "1" },
				{ "slug": "20", "size": "0.75rem", "name": "2" },
				{ "slug": "30", "size": "1.25rem", "name": "3" },
				{ "slug": "40", "size": "1.75rem", "name": "4" },
				{ "slug": "50", "size": "2.5rem", "name": "5" },
				{ "slug": "60", "size": "3.5rem", "name": "6" }
			]
		}
	},
	"styles": {
		"typography": { "lineHeight": "1.6" },
		"spacing": { "blockGap": "var(--wp--preset--spacing--20)" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "700", "lineHeight": "1.3" },
				"color": { "text": "var(--wp--preset--color--primary)" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)" },
				"border": { "bottom": { "width": "1px", "color": "#d9dee3", "style": "solid" } },
				"spacing": { "padding": { "bottom": "var(--wp--preset--spacing--10)" }, "margin": { "top": "var(--wp--preset--spacing--40)" } }
			},
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"border": { "radius": "2px" },
				"typography": { "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--small)" },
				"spacing": { "padding": { "top": "0.625rem", "bottom": "0.625rem", "left": "1.25rem", "right": "1.25rem" } },
				"color": { "background": "var(--wp--preset--color--accent-aa)", "text": "#ffffff" }
			},
			"link": { "color": { "text": "var(--wp--preset--color--accent-aa)" }, "typography": { "textDecoration": "none" }, ":hover": { "typography": { "textDecoration": "underline" } } }
		},
		"blocks": {
			"core/post-content": { "typography": { "lineHeight": "1.7", "fontSize": "var(--wp--preset--font-size--medium)" } },
			"core/site-title": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "700", "letterSpacing": "0.02em" } },
			"core/quote": {
				"color": { "background": "var(--wp--preset--color--secondary)" },
				"border": { "left": { "width": "3px", "color": "var(--wp--preset--color--accent-aa)", "style": "solid" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontStyle": "normal" },
				"spacing": { "padding": { "top": "var(--wp--preset--spacing--20)", "bottom": "var(--wp--preset--spacing--20)", "left": "var(--wp--preset--spacing--30)", "right": "var(--wp--preset--spacing--30)" } }
			},
			"core/table": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" }, "border": { "width": "1px", "color": "#d9dee3", "style": "solid" } },
			"core/post-date": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" }, "color": { "text": "var(--wp--preset--color--muted)" } },
			"core/post-featured-image": { "border": { "radius": "2px" } },
			"core/image": { "border": { "radius": "2px" } }
		},
		"css": ".an-section{border-bottom:1px solid #e3e7eb} .an-section--hero{background:var(--wp--preset--color--secondary)} .wp-block-column,.wp-block-group.is-style-an-card,.wp-block-post-template > li{border:1px solid #d9dee3;border-radius:2px;padding:var(--wp--preset--spacing--30);background:var(--wp--preset--color--background)} .wp-block-column > .wp-block-group,.wp-block-post-template > li > .wp-block-group{border:0;padding:0;background:transparent} header.wp-block-template-part,.wp-site-blocks > header{border-bottom:1px solid #d9dee3} .wp-block-post-content pre,.wp-block-code{border:1px solid #d9dee3;border-radius:2px;background:var(--wp--preset--color--secondary)}"
	}
}
