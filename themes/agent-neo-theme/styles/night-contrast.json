{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "ナイトコントラスト",
  "settings": {
    "color": {
      "palette": [
        { "slug": "primary", "color": "#f6f8ff", "name": "Primary" },
        { "slug": "secondary", "color": "#17213d", "name": "Secondary" },
        { "slug": "accent", "color": "#b8ef4a", "name": "Accent" },
        { "slug": "accent-aa", "color": "#83b82a", "name": "Accent AA (暗背景対応)" },
        { "slug": "background", "color": "#0b1020", "name": "Background" },
        { "slug": "foreground", "color": "#eef3ff", "name": "Foreground" },
        { "slug": "footer-bg", "color": "#050813", "name": "Footer Background" },
        { "slug": "muted", "color": "#a9b6d6", "name": "Muted" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--30)"
    },
    "elements": {
      "heading": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        "typography": { "fontWeight": "800", "lineHeight": "1.15" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent-aa)",
          "text": "var(--wp--preset--color--footer-bg)"
        },
        "border": { "radius": "var(--wp--preset--spacing--20)" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" }
      }
    }
  }
}
