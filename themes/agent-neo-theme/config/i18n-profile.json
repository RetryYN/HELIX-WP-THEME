{
  "$schema": "https://agent-neo.example.com/schemas/i18n-profile.json",
  "_comment": "i18n / RTL 設定（CARRY-G2-013 / TC-017a 契約）。",
  "version": "1.0.0",
  "text_domain": "agent-neo",
  "locales": {
    "primary": "ja",
    "supported": ["ja", "en"]
  },
  "source_languages": ["ja", "en"],
  "rtl": {
    "supported": false,
    "scope": "out-of-scope",
    "strategy": "defensive-logical-properties",
    "_comment": "RTL は対応・検証範囲外。将来の破損を減らすため logical properties を使用するが、RTL 対応済みとは宣言しない。",
    "allowed_physical_exceptions": [
      "border-radius",
      "top",
      "bottom"
    ],
    "rtl_stylesheet": false,
    "_rtl_stylesheet_note": "logical-properties 戦略のため専用 RTL スタイルシートは不要。"
  },
  "i18n_functions": {
    "required": ["__", "_e", "esc_html__", "esc_html_e", "esc_attr__", "esc_attr_e", "esc_url"],
    "prohibited_patterns": [
      "echo '...' (未翻訳日本語直書き)",
      "echo \"...\" (未翻訳日本語直書き)"
    ]
  },
  "pot_file": "languages/agent-neo.pot",
  "translation_catalogs": [],
  "_translation_catalogs_note": "本段階はソース文字列と POT の同期まで。翻訳済み PO/MO の提供は release 判断へ残す。"
}
