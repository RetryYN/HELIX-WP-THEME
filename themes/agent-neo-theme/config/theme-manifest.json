{
  "$schema": "https://agent-neo.local/schemas/theme-manifest.schema.json",
  "name": "AGENT NEO",
  "slug": "agent-neo-theme",
  "version": "0.1.0",
  "text_domain": "agent-neo",
  "modules": [
    "config-loader",
    "boundary-guard",
    "theme-setup"
  ],
  "boundary": {
    "fse_templates_patterns_styles": {
      "owner": "theme",
      "theme_allowed": true,
      "core_plugin_role": "reference"
    },
    "visual_only_block": {
      "owner": "theme",
      "theme_allowed": true,
      "core_plugin_role": "optional_integration"
    },
    "section_id_cta_id_attributes": {
      "owner": "theme",
      "theme_allowed": true,
      "core_plugin_role": "tracking_optimization"
    },
    "seo_head_render": {
      "owner": "theme_adapter",
      "theme_allowed": true,
      "core_plugin_role": "meta_persistence_conflict_detection"
    },
    "json_operation_api": {
      "owner": "core_plugin",
      "theme_allowed": false,
      "theme_role": "manifest_only"
    },
    "cpt_ab_tracking_storage": {
      "owner": "core_plugin",
      "theme_allowed": false,
      "theme_role": "none"
    },
    "catalog_update_trigger": {
      "owner": "core_plugin",
      "theme_allowed": false,
      "theme_role": "none",
      "contract_source": "automation-seo D-PLUGIN-CONTRACT §17 mirror"
    },
    "ai_decision_logic": {
      "owner": "helix",
      "theme_allowed": false,
      "core_plugin_allowed": false,
      "allowed_local_role": "deterministic_contract_and_transport_metadata_only"
    }
  },
  "capabilities": {
    "patterns": [
      "agent-neo/article-author-box",
      "agent-neo/article-cta",
      "agent-neo/article-key-takeaways",
      "agent-neo/article-notice",
      "agent-neo/article-related-grid",
      "agent-neo/author-profile",
      "agent-neo/footer-contact-grid",
      "agent-neo/footer-credit",
      "agent-neo/footer-cta-band",
      "agent-neo/footer-dark-mark",
      "agent-neo/footer-mega",
      "agent-neo/footer-minimal",
      "agent-neo/footer-newsletter",
      "agent-neo/footer-sitemap",
      "agent-neo/footer-social-strip",
      "agent-neo/header-announcement",
      "agent-neo/header-centered",
      "agent-neo/header-dual-brand",
      "agent-neo/header-image",
      "agent-neo/header-menu-focus",
      "agent-neo/header-minimal",
      "agent-neo/header-overlay",
      "agent-neo/header-search",
      "agent-neo/header-split",
      "agent-neo/header-topbar",
      "agent-neo/hero",
      "agent-neo/hero-cover",
      "agent-neo/hero-gradient",
      "agent-neo/hero-split",
      "agent-neo/hero-stat",
      "agent-neo/hero-typographic",
      "agent-neo/hero-video-dark",
      "agent-neo/home-cases",
      "agent-neo/home-final-cta",
      "agent-neo/home-gateway",
      "agent-neo/home-hero",
      "agent-neo/home-overview",
      "agent-neo/home-resources",
      "agent-neo/home-trust",
      "agent-neo/layout-4col-features",
      "agent-neo/layout-bento",
      "agent-neo/layout-split-asym",
      "agent-neo/lp-agitation",
      "agent-neo/lp-benefit",
      "agent-neo/lp-comparison",
      "agent-neo/lp-faq",
      "agent-neo/lp-feature",
      "agent-neo/lp-final-cta",
      "agent-neo/lp-hero",
      "agent-neo/lp-pricing",
      "agent-neo/lp-problem",
      "agent-neo/lp-proof",
      "agent-neo/lp-solution",
      "agent-neo/lp-use-case",
      "agent-neo/section-comparison",
      "agent-neo/section-contact-band",
      "agent-neo/section-cover-band",
      "agent-neo/section-faq",
      "agent-neo/section-logo-strip",
      "agent-neo/section-pricing-grid",
      "agent-neo/section-steps",
      "agent-neo/section-testimonials",
      "agent-neo/share-buttons",
      "agent-neo/sidebar-author",
      "agent-neo/sidebar-cta",
      "agent-neo/sidebar-index",
      "agent-neo/sidebar-magazine",
      "agent-neo/sidebar-newsletter",
      "agent-neo/sidebar-popular",
      "agent-neo/sidebar-sticky",
      "agent-neo/sidebar-tag-cloud"
    ],
    "template_parts": [
      "footer",
      "header",
      "post-footer",
      "post-header",
      "sidebar"
    ],
    "templates": [
      "404",
      "archive",
      "blank",
      "front-page",
      "index",
      "no-header",
      "page",
      "page-lp-sample",
      "search",
      "single"
    ],
    "style_variations": [
      "business",
      "dark",
      "depth",
      "editorial",
      "light",
      "mono",
      "night-contrast",
      "vivid",
      "warm"
    ],
    "slots": [
      "agent_neo_hero",
      "home_cases",
      "home_final_cta",
      "home_gateway",
      "home_hero",
      "home_overview",
      "home_resources",
      "home_trust"
    ],
    "value_scales": {
      "settings.color.palette": [
        "accent",
        "accent-aa",
        "background",
        "footer-bg",
        "foreground",
        "muted",
        "primary",
        "secondary"
      ],
      "settings.color.gradients": [
        "accent-glow",
        "accent-to-primary",
        "overlay-dark",
        "primary-to-footer",
        "secondary-fade"
      ],
      "settings.typography.fontFamilies": [
        "body",
        "heading",
        "mono"
      ],
      "settings.typography.fontSizes": [
        "large",
        "medium",
        "small",
        "x-large",
        "xx-large",
        "xxx-large"
      ],
      "settings.shadow.presets": [
        "0",
        "1",
        "2",
        "3",
        "4"
      ],
      "settings.spacing.spacingSizes": [
        "10",
        "20",
        "30",
        "40",
        "50",
        "60"
      ]
    },
    "hooks": [
      {
        "type": "action",
        "hook": "admin_notices",
        "source": "inc/class-agent-neo-theme.php"
      },
      {
        "type": "action",
        "hook": "after_setup_theme",
        "source": "inc/setup/class-theme-setup.php"
      },
      {
        "type": "action",
        "hook": "init",
        "source": "inc/setup/class-theme-setup.php"
      },
      {
        "type": "action",
        "hook": "wp_enqueue_scripts",
        "source": "inc/assets/class-third-party-manager.php"
      },
      {
        "type": "action",
        "hook": "wp_enqueue_scripts",
        "source": "inc/setup/class-theme-setup.php"
      },
      {
        "type": "action",
        "hook": "wp_footer",
        "source": "inc/assets/class-third-party-manager.php"
      },
      {
        "type": "action",
        "hook": "wp_head",
        "source": "inc/assets/class-third-party-manager.php"
      },
      {
        "type": "action",
        "hook": "wp_head",
        "source": "inc/seo/class-head-meta.php"
      },
      {
        "type": "action",
        "hook": "wp_head",
        "source": "inc/seo/class-head-meta.php"
      },
      {
        "type": "action",
        "hook": "wp_head",
        "source": "inc/seo/class-structured-data.php"
      },
      {
        "type": "filter",
        "hook": "embed_oembed_html",
        "source": "inc/seo/class-oembed-lazy.php"
      },
      {
        "type": "filter",
        "hook": "query_loop_block_query_vars",
        "source": "inc/class-related-query.php"
      },
      {
        "type": "filter",
        "hook": "wp_robots",
        "source": "inc/seo/class-head-meta.php"
      }
    ]
  }
}
