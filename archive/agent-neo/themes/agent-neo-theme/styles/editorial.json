{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "編集誌",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#14161a", "name": "Primary" },
				{ "slug": "secondary", "color": "#eceff3", "name": "Secondary" },
				{ "slug": "accent", "color": "#1f4fd8", "name": "Accent" },
				{ "slug": "accent-aa", "color": "#1a3fae", "name": "Accent AA (白文字対応)" },
				{ "slug": "background", "color": "#f7f7f5", "name": "Background" },
				{ "slug": "foreground", "color": "#1c1e22", "name": "Foreground" },
				{ "slug": "footer-bg", "color": "#14161a", "name": "Footer Background" },
				{ "slug": "muted", "color": "#5f636b", "name": "Muted" }
			]
		},
		"typography": {
			"fontSizes": [
				{ "slug": "small", "size": "0.9375rem", "name": "Small" },
				{ "slug": "medium", "size": "1.0625rem", "name": "Medium" },
				{ "slug": "large", "size": "1.375rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.75rem", "name": "X-Large" },
				{ "slug": "xx-large", "size": "2.75rem", "name": "XX-Large" },
				{ "slug": "xxx-large", "size": "4rem", "name": "XXX-Large" }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "10", "size": "0.5rem", "name": "1" },
				{ "slug": "20", "size": "1rem", "name": "2" },
				{ "slug": "30", "size": "1.75rem", "name": "3" },
				{ "slug": "40", "size": "2.75rem", "name": "4" },
				{ "slug": "50", "size": "4.5rem", "name": "5" },
				{ "slug": "60", "size": "6.5rem", "name": "6" }
			]
		}
	},
	"styles": {
		"typography": {
			"lineHeight": "1.85",
			"letterSpacing": "0.01em"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.25",
					"letterSpacing": "-0.005em"
				}
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xxx-large)", "lineHeight": "1.08", "letterSpacing": "-0.02em" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" },
				"spacing": { "margin": { "top": "var(--wp--preset--spacing--50)", "bottom": "var(--wp--preset--spacing--20)" } }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--foreground)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent-aa)" } }
			},
			"button": {
				"border": { "radius": "0" },
				"typography": { "fontWeight": "600", "letterSpacing": "0.04em" },
				"color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--background)" },
				":hover": { "color": { "background": "var(--wp--preset--color--accent-aa)" } }
			}
		},
		"blocks": {
			"core/post-content": { "typography": { "lineHeight": "1.9", "fontSize": "var(--wp--preset--font-size--medium)" } },
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--large)", "letterSpacing": "0.02em" } },
			"core/quote": {
				"border": { "left": { "width": "2px", "color": "var(--wp--preset--color--primary)", "style": "solid" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "var(--wp--preset--font-size--large)", "fontStyle": "normal" },
				"spacing": { "padding": { "left": "var(--wp--preset--spacing--30)" } }
			},
			"core/separator": { "color": { "text": "var(--wp--preset--color--primary)" }, "css": "opacity:1;border-width:1px 0 0;" },
			"core/post-date": { "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--small)", "letterSpacing": "0.06em", "textTransform": "uppercase" } },
			"core/post-terms": { "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--small)", "letterSpacing": "0.06em" } }
		},
		"css": ".an-section{border-top:1px solid var(--wp--preset--color--primary)} .an-section--hero{border-top:0;background:var(--wp--preset--color--background)} .wp-block-post-title{font-family:var(--wp--preset--font-family--heading)} .wp-block-post-featured-image img{border-radius:0} .wp-block-group.is-style-an-card,.wp-block-column{border:0;border-top:1px solid var(--wp--preset--color--primary);border-radius:0;box-shadow:none;padding-top:var(--wp--preset--spacing--20)}"
	}
}
