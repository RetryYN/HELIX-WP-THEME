{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "モノ",
  "settings": {
    "color": {
      "palette": [
        { "slug": "primary", "color": "#111111", "name": "Primary" },
        { "slug": "secondary", "color": "#e7e7e7", "name": "Secondary" },
        { "slug": "accent", "color": "#333333", "name": "Accent" },
        { "slug": "accent-aa", "color": "#111111", "name": "Accent AA (白文字対応)" },
        { "slug": "background", "color": "#ffffff", "name": "Background" },
        { "slug": "foreground", "color": "#111111", "name": "Foreground" },
        { "slug": "footer-bg", "color": "#000000", "name": "Footer Background" },
        { "slug": "muted", "color": "#666666", "name": "Muted" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--20)"
    },
    "elements": {
      "heading": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        "typography": { "fontWeight": "800", "lineHeight": "1.1" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent-aa)",
          "text": "var(--wp--preset--color--background)"
        },
        "border": { "radius": "0" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--accent-aa)" },
        "typography": { "textDecoration": "underline" }
      }
    }
  }
}
