{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "ビビッド",
  "settings": {
    "color": {
      "palette": [
        { "slug": "primary", "color": "#2d1154", "name": "Primary" },
        { "slug": "secondary", "color": "#fff0f8", "name": "Secondary" },
        { "slug": "accent", "color": "#ff4d91", "name": "Accent" },
        { "slug": "accent-aa", "color": "#bd1d61", "name": "Accent AA (白文字対応)" },
        { "slug": "background", "color": "#fffaff", "name": "Background" },
        { "slug": "foreground", "color": "#251630", "name": "Foreground" },
        { "slug": "footer-bg", "color": "#21103c", "name": "Footer Background" },
        { "slug": "muted", "color": "#735676", "name": "Muted" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--30)"
    },
    "elements": {
      "heading": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        "typography": { "fontWeight": "800", "lineHeight": "1.15" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent-aa)",
          "text": "var(--wp--preset--color--background)"
        },
        "border": { "radius": "var(--wp--preset--spacing--20)" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--accent-aa)" }
      }
    }
  }
}
