{
  "name": "agent-neo-e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:e2e": "npx playwright test",
    "helix": "tsx node_modules/helix/src/cli.ts",
    "typecheck": "echo \"no typecheck target (WP theme: PHP/CSS)\"",
    "test": "npm run requirements:validate && npm run requirements:helix-l1-l2 && npm run requirements:helix-vmodel && npm run helix -- doctor --profile consumer",
