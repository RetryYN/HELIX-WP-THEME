{
  "name": "helix-wp-theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "reduced-motion:verify": "node docs/research/2026-09-10-reduced-motion/verify.mjs",
    "test:e2e": "npx playwright test",
    "helix": "tsx node_modules/helix/src/cli.ts",
    "typecheck": "echo \"no typecheck target (WP theme: PHP/CSS)\"",
    "test": "npm run requirements:validate && npm run requirements:helix-l1-l2 && npm run requirements:helix-vmodel && npm run capabilities:verify && npm run boundary:verify-ai && npm run public-safety:verify && npm run i18n:verify && npm run helix -- doctor --profile consumer && npm run test:helix-patch",
    "requirements:validate": "node scripts/validate-requirements.mjs",
    "requirements:helix-l1-l2": "node scripts/validate-helix-l1-l2.mjs",
    "requirements:helix-vmodel": "npm run helix -- vmodel lint",
    "capabilities:verify": "node scripts/verify-capability-manifest.mjs",
    "capabilities:verify-runtime": "node scripts/verify-capability-health.mjs",
    "boundary:verify-ai": "node scripts/verify-ai-boundary.mjs",
    "public-safety:verify": "node scripts/verify-public-safety.mjs",
    "i18n:verify": "node scripts/verify-i18n-profile.mjs",
    "i18n:pot": "node scripts/verify-i18n-profile.mjs --write-pot",
    "current-theme-quality:verify": "node docs/research/2026-09-10-current-theme-quality/verify.mjs",
    "postinstall": "node scripts/patch-helix-receipt.mjs && node scripts/patch-helix-consumer-review.mjs",
    "test:helix-patch": "tsx --test tests/unit/helix-receipt-patch.test.mjs tests/unit/helix-consumer-review-patch.test.mjs tests/unit/consumer-receipt-contract.test.mjs tests/unit/consumer-receipt-generator.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "helix": "github:RetryYN/HELIX-HARNESS#19d0bffd",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
