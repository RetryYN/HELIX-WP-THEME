{
  "name": "helix-wp-theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "reduced-motion:verify": "node docs/research/2026-09-10-reduced-motion/verify.mjs",
    "test:e2e": "npx playwright test",
    "helix": "tsx node_modules/helix/src/cli.ts",
    "typecheck": "echo \"no typecheck target (WP theme: PHP/CSS)\"",
    "test": "npm run requirements:validate && npm run requirements:helix-l1-l2 && npm run requirements:helix-vmodel && npm run capabilities:verify && npm run boundary:verify-ai && npm run privacy:verify && npm run public-safety:verify && npm run artifact-bindings:verify && npm run zone-overrides:verify && npm run catalog-evidence:rebind-test && npm run catalog-evidence:rebind-check && npm run catalog-evidence:audit && npm run i18n:verify && npm run helix -- doctor --profile consumer && npm run test:helix-patch && npm run test:quality-contracts && npm run test:codex-inbox",
    "test:codex-inbox": "node --test tests/unit/codex-inbox.test.mjs",
    "test:quality-contracts": "node --test tests/lighthouse-ci-contract.test.mjs tests/current-theme-quality-regression.test.mjs",
    "requirements:validate": "node scripts/validate-requirements.mjs",
    "requirements:helix-l1-l2": "node scripts/validate-helix-l1-l2.mjs",
    "requirements:helix-vmodel": "npm run helix -- vmodel lint",
    "capabilities:verify": "node scripts/verify-capability-manifest.mjs",
    "capabilities:verify-runtime": "node scripts/verify-capability-health.mjs",
    "boundary:verify-ai": "node scripts/verify-ai-boundary.mjs",
    "privacy:verify": "node scripts/verify-privacy-boundary.mjs",
    "public-safety:verify": "node scripts/verify-public-safety.mjs",
    "artifact-bindings:verify": "node scripts/verify-artifact-source-bindings.mjs",
    "catalog-evidence:rebind": "node scripts/rebind-acceptance-evidence.mjs",
    "catalog-evidence:rebind-test": "node --test tests/acceptance-rebind.test.mjs tests/catalog-evidence.test.mjs",
    "catalog-evidence:rebind-check": "node scripts/rebind-acceptance-evidence.mjs --check",
    "catalog-evidence:audit": "node scripts/audit-catalog-evidence.mjs",
    "i18n:verify": "node scripts/verify-i18n-profile.mjs",
    "i18n:pot": "node scripts/verify-i18n-profile.mjs --write-pot",
    "current-theme-quality:verify": "node docs/research/2026-09-10-current-theme-quality/verify.mjs",
    "postinstall": "node scripts/patch-helix-receipt.mjs && node scripts/patch-helix-consumer-review.mjs",
    "test:helix-patch": "tsx --test tests/unit/helix-receipt-patch.test.mjs tests/unit/helix-consumer-review-patch.test.mjs tests/unit/consumer-receipt-contract.test.mjs tests/unit/consumer-receipt-generator.test.ts",
    "recovery-contract:verify": "node scripts/verify-recovery-contract-poc.mjs",
    "zone-overrides:verify": "node scripts/verify-zone-overrides-poc.mjs",
    "article-purpose:verify": "node docs/research/2026-09-26-news-column-purpose-gap/verify.mjs",
    "article-purpose:proof": "node scripts/verify-article-purpose-proof-binding.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "helix": "github:RetryYN/HELIX-HARNESS#19d0bffd",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "catalogOracles": {
    "docs/research/2026-09-09-public-safety/verify.json": "public-safety:verify",
    "docs/research/2026-09-10-reduced-motion/verify.json": "reduced-motion:verify",
    "docs/research/2026-09-13-privacy-boundary/verify.json": "privacy:verify",
    "docs/research/2026-09-20-recovery-contract-poc/verification.json": "recovery-contract:verify",
    "docs/research/2026-09-20-zone-overrides-poc/verification.json": "zone-overrides:verify",
    "docs/research/2026-09-26-news-column-purpose-gap/results/verify.json": "article-purpose:proof"
  }
}
