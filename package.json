    "requirements:helix-l1-l2": "node scripts/validate-helix-l1-l2.mjs",
    "requirements:helix-vmodel": "npm run helix -- vmodel lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "helix": "github:RetryYN/HELIX-HARNESS#19d0bffd",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
