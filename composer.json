{
    "name": "agent-neo/agent-neo",
    "description": "AGENT NEO 1st-party WordPress theme/plugin — test infrastructure",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "yoast/phpunit-polyfills": "^1.1.5 || ^2.0",
        "brain/monkey": "^2.7",
        "yoast/wp-test-utils": "^1.2",
        "wp-phpunit/wp-phpunit": "^6.9 || ^7.0"
    },
    "autoload": {
        "psr-4": {}
    },
    "autoload-dev": {
        "psr-4": {
            "AgentNeo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:unit": "vendor/bin/phpunit --testsuite unit --colors=always",
        "test:integration": "vendor/bin/phpunit --testsuite integration --colors=always",
        "test:security": "vendor/bin/phpunit --testsuite security --colors=always",
        "test:all": [
            "@test:unit",
            "@test:security"
        ]
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
