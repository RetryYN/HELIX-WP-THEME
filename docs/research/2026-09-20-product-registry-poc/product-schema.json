{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "products"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "price",
          "features",
          "rating",
          "image",
          "linkType",
          "url",
          "source",
          "retrievedAt",
          "freshForHours"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^light-[a-z]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "image": {
            "type": "string",
            "pattern": "^light-[a-z]+\\.svg$"
          },
          "linkType": {
            "type": "string",
            "enum": [
              "affiliate",
              "external-store",
              "self-ec"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://example\\.com/[a-z0-9/-]+$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "retrievedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "freshForHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 168
          }
        }
      }
    }
  }
}
